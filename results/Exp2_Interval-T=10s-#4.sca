version 3
run Exp2_Interval-14-20260830-17:27:28-74140
attr configname Exp2_Interval
attr datetime 20260830-17:27:28
attr datetimef 20260830-172728
attr experiment Exp2_Interval
attr inifile experiment2_interval.ini
attr iterationvars $T=10s
attr iterationvarsd T=10s
attr iterationvarsf T=10s-
attr measurement $T=10s
attr network smarthome.ScalabilityNetwork
attr processid 74140
attr repetition 4
attr replication #4
attr resultdir results
attr runnumber 14
attr seedset 4
itervar T 10s
config network smarthome.ScalabilityNetwork
config sim-time-limit 600s
config repeat 5
config seed-set 4
config **.arp.typename GlobalArp
config *.radioMedium.backgroundNoise.power -110dBm
config *.configurator.addStaticRoutes true
config *.numNodes 12
config *.node[*].numApps 1
config *.node[*].app[0].typename UdpBasicApp
config *.node[*].app[0].destAddresses "\"monitoringApp\""
config *.node[*].app[0].destPort 5000
config *.node[*].app[0].sendInterval 10s
config *.node[*].app[0].messageLength 50B
config *.node[*].app[0].packetName "\"SensorData\""
config *.node[*].app[0].startTime "uniform(0s, 10s)"
config *.monitoringApp.numApps 1
config *.monitoringApp.app[0].typename UdpSink
config *.monitoringApp.app[0].localPort 5000
config **.vector-recording false
config **.scalar-recording true
config **.energyStorage.residualEnergyCapacity.result-recording-modes +last

