itervar I 1s
config network smarthome.SmartHomeNetwork
config sim-time-limit 300s
config repeat 5
config seed-set 1
config **.arp.typename GlobalArp
config *.radioMedium.backgroundNoise.power -110dBm
config *.configurator.addStaticRoutes true
config *.temp*.numApps 1
config *.temp*.app[0].typename UdpEchoApp
config *.temp*.app[0].localPort 5000
config *.motion*.numApps 1
config *.motion*.app[0].typename UdpEchoApp
config *.motion*.app[0].localPort 5000
config *.monitoringApp.numApps 6
config *.monitoringApp.app[*].typename UdpBasicApp
config *.monitoringApp.app[*].destPort 5000
config *.monitoringApp.app[*].sendInterval 1s
config *.monitoringApp.app[*].messageLength 10B
config *.monitoringApp.app[*].packetName "\"PollRequest\""
config *.monitoringApp.app[*].startTime "uniform(0s, 1s)"
config *.monitoringApp.app[0].destAddresses "\"temp1\""
