config *.monitoringApp.app[2].destAddresses "\"temp3\""
config *.monitoringApp.app[3].destAddresses "\"motion1\""
config *.monitoringApp.app[4].destAddresses "\"motion2\""
config *.monitoringApp.app[5].destAddresses "\"motion3\""
config **.vector-recording false
config **.scalar-recording true

